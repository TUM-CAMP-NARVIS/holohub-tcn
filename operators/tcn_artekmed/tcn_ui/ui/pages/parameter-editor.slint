// parameter_editor.slint

import { UText, UButton } from "@sleek-ui/widgets.slint";
import { Page } from "../components/page.slint";
import { RpcClient, ParameterSchema, Parameter } from "../components/rpc-client.slint";

import {
    StandardTableView,
    SpinBox,
    CheckBox,
    LineEdit,
    VerticalBox,
    HorizontalBox,
    ListView
} from "std-widgets.slint";

// A single parameter row in the model


export component ParameterEditor inherits Page {

    in-out property<string> component-name: "";

    // Editable parameter model exposed to Python
    in-out property<[ParameterSchema]> parameter-schema: RpcClient.get-parameter-schema(root.component-name);
    in-out property<[Parameter]> parameter-values: RpcClient.get-parameter-values(root.component-name);

    // Simple text for validation errors
    in-out property<string> validation_error;

    VerticalBox {
        padding: 8px;
        spacing: 8px;

        // Validation error line
        UText {
            text: root.validation_error;
            color: #c62828;
        }

        UText {
            text: "Edit parameters";
            font-weight: 600;
        }

        // Actual editors: one row per parameter, with type-specific widget
        ListView {
            for p[i] in parameter-values : HorizontalBox {
                spacing: 8px;
                width: parent.width;

                UText {
                    width: 160px;
                    text: p.name;
                }

                // Integer: SpinBox
                if (p.type == "int") : SpinBox {
                    width: 120px;
                    minimum: -100000;
                    maximum: 100000;
                    value: p.int_value;

                    edited(new_val) => {
                        p.int_value = new_val;
                        RpcClient.set-parameter-values(
                            root.component-name,
                            [{name: p.name, type: p.type,
                            int_value: new_val, float_value: p.float_value,
                            bool_value: p.bool_value, string_value: p.string_value}]
                        );
                    }
                }

                // Boolean: CheckBox
                if (p.type == "bool") : CheckBox {
                    text: "";
                    checked: p.bool_value;

                    toggled => {
                        p.bool_value = self.checked;
                        RpcClient.set-parameter-values(
                            root.component-name,
                            [{name: p.name, type: p.type,
                            int_value: p.int_value, float_value: p.float_value,
                            bool_value: self.checked, string_value: p.string_value}]
                        );
                    }
                }

                // Float: LineEdit, value as text (validated on Python side)
                if (p.type == "float") : LineEdit {
                    width: 120px;
                    text: p.string_value;

                    edited(new_text) => {
                        p.string_value = new_text;
                        RpcClient.set-parameter-values(
                            root.component-name,
                            [{name: p.name, type: p.type,
                            int_value: p.int_value, float_value: p.float_value,
                            bool_value: p.bool_value, string_value: new_text}]
                        );
                    }
                }

                // String: LineEdit
                if (p.type == "string") : LineEdit {
                    width: 240px;
                    text: p.string_value;

                    edited(new_text) => {
                        p.string_value = new_text;
                        RpcClient.set-parameter-values(
                            root.component-name,
                            [{name: p.name, type: p.type,
                            int_value: p.int_value, float_value: p.float_value,
                            bool_value: p.bool_value, string_value: new_text}]
                        );
                    }
                }
            }
        }
    }
}
