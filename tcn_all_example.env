# Copy this file to .tcn_all_env and adjust the host paths for your machine.
# The launcher loads .tcn_all_env automatically from the repository root.

# Mount /tmp/tcn at /srv/tmp and enable Holoscan profiling.
TCN_ALL_MOUNT_TMP=1
TCN_ALL_TMP_HOST=/tmp/tcn

# Mount this host directory at /srv/models.
TCN_ALL_MOUNT_MODELS=1
TCN_ALL_MODELS_HOST=/data/models_trt11

# Mount this host directory at /workspace/volumes/artekmed_test_data.
# Set TCN_ALL_MOUNT_TEST_DATA=0 when replay data is unavailable or not needed.
TCN_ALL_MOUNT_TEST_DATA=1
TCN_ALL_TEST_DATA_HOST=/home/ecku/develop/artekmed/artekmed_test_data

# Mount this host directory at /workspace/volumes/zenoh_config.
# Set TCN_ALL_MOUNT_ZENOH_CONFIG=0 if the application does not use Zenoh.
TCN_ALL_MOUNT_ZENOH_CONFIG=1
TCN_ALL_ZENOH_CONFIG_HOST=/home/ecku/develop/holoscan/zenoh_config

# Base image passed to holohub.
TCN_ALL_BASE_IMAGE=holoscan-trt11:4.4.0-cu13

# -----------------------------------------------------------------------------
# TRT 11 build-test paths
# trt11_build_test.sh loads this same .tcn_all_env file. These defaults are
# relative to the repository checkout where that is practical.

# Holoscan SDK checkout (repository root/../../holoscan/holoscan-sdk).
SDK_DIR=/home/narvis/develop/ulrich/holoscan-sdk

# HoloHub checkout. Relative paths are resolved from the project root.
HOLOHUB_DIR=.

# Existing TRT 10 model inputs and separate TRT 11 output tree.
ENGINE_SRC_HOST=/data/models
ENGINE_OUT_HOST=/data/models_trt11

# Dataset checkout (repository root/../../artekmed/artekmed_test_data).
DATASET_HOST=/home/narvis/develop/apps/artekmed_test_data

# Shared scratch directory used for logs, gates, and profiling output.
TMP_HOST=$TCN_ALL_TMP_HOST

# Optional X11 authentication file. Leave unset to auto-detect /tmp/.docker.xauth-*.
# XAUTH_FILE=/tmp/.docker.xauth-display
