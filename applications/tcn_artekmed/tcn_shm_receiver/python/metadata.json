{
	"application": {
		"name": "tcn_shm_receiver",
		"description": "TUM-CAMP-NARVIS Artekmed",
		"authors": [
			{
				"name": "Ulrich Eck",
				"affiliation": "TU Munich"
			}
		],
		"language": "python",
		"version": "0.1.0",
		"changelog": {
			"0.1.0": "Initial Release"
		},
		"dockerfile": "applications/tcn_artekmed/Dockerfile",
		"holoscan_sdk": {
			"minimum_required_version": "3.7.0",
			"tested_versions": [
				"3.7.0"
			]
		},
		"platforms": ["x86_64", "aarch64"],
		"tags": [
			"Streaming",
			"Shared Memory",
			"Video"
		],
		"ranking": 1,
		"requirements": {
			"gpu": {
				"type": "hardware",
				"name": "gpu",
				"description": "NVIDIA GPU with at least 8GB memory required for Isaac Sim"
			},
			"packages": [
			]
		},
		"default_mode": "standard",
		"modes": {
			"standard": {
				"description": "Standard mode for tcn_artekmed - development, testing, and basic usage",
				"requirements": [],
				"run": {
					"command":
            "python3 <holohub_app_source>/tcn_shm_receiver.py"
          ,
					"workdir": "holohub_bin"
				}
			},
			"console": {
				"description": "console",
				"requirements": [],
				"run": {
					"command":
            "/bin/bash"
          ,
					"workdir": "holohub_bin"
				}
			}

		}
	}
}
